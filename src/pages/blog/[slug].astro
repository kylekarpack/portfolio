---
import { getCollection } from "astro:content";
import Shell from "../../layouts/Shell.astro";
import { BlogPost } from "../../views/BlogPost";
import { renderMarkdown } from "../../lib/markdown";

export async function getStaticPaths() {
  const items = await getCollection("blog");
  return items.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const contentHtml = await renderMarkdown(post.body ?? "");
---

<Shell title={post.data.title} description={post.data.description}>
  <BlogPost
    title={post.data.title}
    publicationDate={post.data.publicationDate}
    previewImage={post.data.previewImage}
    contentHtml={contentHtml}
  />
</Shell>
