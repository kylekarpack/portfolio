---
/**
 * PWA wiring carried over from the old React `Pwa` component: static
 * `<link>` / `<meta>` tags rendered into the layout head.
 */
const splashImages = [
  { width: 2048, height: 2732, deviceWidth: 1024, deviceHeight: 1366, ratio: 2 },
  { width: 2732, height: 2048, deviceWidth: 1024, deviceHeight: 1366, ratio: 2, orientation: "landscape" },
  { width: 1668, height: 2388, deviceWidth: 834, deviceHeight: 1194, ratio: 2 },
  { width: 2388, height: 1668, deviceWidth: 834, deviceHeight: 1194, ratio: 2, orientation: "landscape" },
  { width: 1536, height: 2048, deviceWidth: 768, deviceHeight: 1024, ratio: 2 },
  { width: 2048, height: 1536, deviceWidth: 768, deviceHeight: 1024, ratio: 2, orientation: "landscape" },
  { width: 1668, height: 2224, deviceWidth: 834, deviceHeight: 1112, ratio: 2 },
  { width: 2224, height: 1668, deviceWidth: 834, deviceHeight: 1112, ratio: 2, orientation: "landscape" },
  { width: 1620, height: 2160, deviceWidth: 810, deviceHeight: 1080, ratio: 2 },
  { width: 2160, height: 1620, deviceWidth: 810, deviceHeight: 1080, ratio: 2, orientation: "landscape" },
  { width: 1290, height: 2796, deviceWidth: 430, deviceHeight: 932, ratio: 3 },
  { width: 2796, height: 1290, deviceWidth: 430, deviceHeight: 932, ratio: 3, orientation: "landscape" },
  { width: 1179, height: 2556, deviceWidth: 393, deviceHeight: 852, ratio: 3 },
  { width: 2556, height: 1179, deviceWidth: 393, deviceHeight: 852, ratio: 3, orientation: "landscape" },
  { width: 1284, height: 2778, deviceWidth: 428, deviceHeight: 926, ratio: 2 },
  { width: 2778, height: 1284, deviceWidth: 428, deviceHeight: 926, ratio: 2, orientation: "landscape" },
  { width: 1170, height: 2532, deviceWidth: 390, deviceHeight: 844, ratio: 3 },
  { width: 2532, height: 1170, deviceWidth: 390, deviceHeight: 844, ratio: 3, orientation: "landscape" },
  { width: 1125, height: 2436, deviceWidth: 375, deviceHeight: 812, ratio: 2 },
  { width: 2436, height: 1125, deviceWidth: 375, deviceHeight: 812, ratio: 2, orientation: "landscape" },
  { width: 1242, height: 2688, deviceWidth: 414, deviceHeight: 896, ratio: 3 },
  { width: 2688, height: 1242, deviceWidth: 414, deviceHeight: 896, ratio: 3, orientation: "landscape" },
  { width: 828, height: 1792, deviceWidth: 414, deviceHeight: 896, ratio: 2 },
  { width: 1792, height: 828, deviceWidth: 414, deviceHeight: 896, ratio: 2, orientation: "landscape" },
  { width: 1242, height: 2208, deviceWidth: 414, deviceHeight: 736, ratio: 3 },
  { width: 2208, height: 1242, deviceWidth: 414, deviceHeight: 736, ratio: 3, orientation: "landscape" },
  { width: 750, height: 1334, deviceWidth: 375, deviceHeight: 667, ratio: 3 },
  { width: 1334, height: 750, deviceWidth: 375, deviceHeight: 667, ratio: 3, orientation: "landscape" },
  { width: 640, height: 1136, deviceWidth: 320, deviceHeight: 568, ratio: 2 },
  { width: 1136, height: 640, deviceWidth: 320, deviceHeight: 568, ratio: 2, orientation: "landscape" },
];

const mediaFor = (splash: (typeof splashImages)[number]) => {
  const parts = [
    `(device-width: ${splash.deviceWidth}px)`,
    `(device-height: ${splash.deviceHeight}px)`,
    `(-webkit-device-pixel-ratio: ${splash.ratio})`,
  ];
  if ("orientation" in splash) {
    parts.push(`(orientation: ${splash.orientation})`);
  }
  return parts.join(" and ");
};
---

<link rel="apple-touch-icon" href="/branding/splash/apple-icon-180.png" />
<meta name="mobile-web-app-capable" content="yes" />
{
  splashImages.map((splash) => (
    <link
      rel="apple-touch-startup-image"
      href={`/branding/splash/apple-splash-${splash.width}-${splash.height}.jpg`}
      media={mediaFor(splash)}
    />
  ))
}
