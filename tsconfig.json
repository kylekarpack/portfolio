{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vitest/globals"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./*"]
    },
    "target": "ES2018"
  },
  "include": ["**/*.ts", "**/*.tsx", ".astro/types.d.ts", "astro.config.mts", "src/**/*.astro"],
  "exclude": ["node_modules", "dist"]
}
